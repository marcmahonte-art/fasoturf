# ============================================================
# Hippo Engine — variables d'environnement (#41)
# Copier vers .env — ne JAMAIS committer le .env réel.
# Aucune de ces valeurs n'est jamais exposée au frontend.
# ============================================================

# --- Base de données ---
# PostgreSQL / Supabase (optionnel : SQLite est utilisé par défaut)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Base SQLite réelle du projet (provider par défaut)
SQLITE_PATH=C:\Users\Lenovo\Desktop\PMU\pmu-lonab-scraper\data\processed\pmu_lonab.db

# --- Fournisseur de données (#4) ---
# mock | sqlite | pmu | external
DATA_PROVIDER=sqlite

EXTERNAL_API_URL=
EXTERNAL_API_KEY=

# --- Services ---
REDIS_URL=
ML_SERVICE_URL=

# --- Moteur de pronostics ---
# Seuil de détection VALUE (#16) — configurable, jamais figé
VALUE_THRESHOLD=0.03
VALUE_RATIO_THRESHOLD=1.10

MODEL_VERSION=catboost_v1

# --- Découpage temporel train/validation/test (#14) ---
TRAIN_UNTIL=2025-06-30
VALID_UNTIL=2025-12-31
