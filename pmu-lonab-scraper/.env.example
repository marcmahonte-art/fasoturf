# Configuration du scraper PMU'B LONAB
# Copiez ce fichier en .env et ajustez les valeurs

# Délai entre les requêtes HTTP (en secondes)
REQUEST_DELAY=2.0

# Timeout des requêtes HTTP (en secondes)
REQUEST_TIMEOUT=30

# Nombre de tentatives en cas d'échec
MAX_RETRIES=3

# Répertoire de stockage des données
DATA_DIR=data

# Niveau de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
